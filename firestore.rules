rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check ownership of existing document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check ownership of resource
    function isDocOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Helper function for creating new documents
    function isCreatingForSelf() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // User Profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write, create, update: if isOwner(userId);
    }

    // Exams collection
    match /exams/{examId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isCreatingForSelf();
    }

    // Study Items collection (syllabus chapters, topics, formulas)
    match /studyItems/{itemId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isCreatingForSelf();
    }

    // Study Materials & Lecture Notes collection
    match /materials/{materialId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isCreatingForSelf();
    }

    // Mistake Book collection
    match /mistakes/{mistakeId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isCreatingForSelf();
    }

    // Test History & Exam Attempts
    match /testHistory/{historyId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isCreatingForSelf();
    }

    match /attempts/{attemptId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isCreatingForSelf();
    }

    match /generatedTests/{testId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isCreatingForSelf();
    }

    // User Specific Subcollections fallback
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }
  }
}
